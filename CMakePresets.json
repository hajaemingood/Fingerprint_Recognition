{
  "version": 3,
  "configurePresets": [
    {
      "name": "vs2022-x64",
      "displayName": "Visual Studio 2022 x64 - DeepPrint + UI",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/vs2022-deepprint",
      "cacheVariables": {
        "BUILD_TESTING": "ON",
        "FINGERPRINT_BUILD_GUI": "ON",
        "FINGERPRINT_DEEPPRINT": "ON",
        "FINGERPRINT_DEEPPRINT_REFERENCE_DIR": "${sourceDir}/build/models/parity"
      }
    },
    {
      "name": "vs2022-deepprint",
      "inherits": "vs2022-x64",
      "displayName": "DeepPrint DLL + UI",
      "cacheVariables": {
        "FINGERPRINT_DEEPPRINT": "ON"
      }
    },
    {
      "name": "vs2022-ui-only",
      "inherits": "vs2022-x64",
      "displayName": "Windows x64 UI only - select external KISA DLL",
      "binaryDir": "${sourceDir}/build/vs2022-ui",
      "cacheVariables": {
        "FINGERPRINT_DEEPPRINT": "OFF",
        "FINGERPRINT_DEEPPRINT_REFERENCE_DIR": "",
        "BUILD_TESTING": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "vs2022-debug",
      "configurePreset": "vs2022-x64",
      "configuration": "Debug"
    },
    {
      "name": "vs2022-release",
      "configurePreset": "vs2022-x64",
      "configuration": "Release"
    },
    {
      "name": "vs2022-deepprint-release",
      "configurePreset": "vs2022-deepprint",
      "configuration": "Release"
    },
    {
      "name": "vs2022-ui-release",
      "configurePreset": "vs2022-ui-only",
      "configuration": "Release",
      "targets": [
        "fingerprint_compare"
      ]
    }
  ],
  "testPresets": [
    {
      "name": "vs2022-release",
      "configurePreset": "vs2022-x64",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "vs2022-debug",
      "configurePreset": "vs2022-x64",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
