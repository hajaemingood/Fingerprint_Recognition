# Re-run a complete native experiment, build its KISA DLL, and check every rounded score.
cmake_minimum_required(VERSION 3.20)
get_filename_component(root "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
if(NOT STUDY MATCHES "^(branches|augmentation)$")
    message(FATAL_ERROR "Pass -DSTUDY=branches or -DSTUDY=augmentation")
endif()
if(NOT DEFINED OUTPUT)
    set(OUTPUT "build/cpp-results/${STUDY}")
endif()
get_filename_component(out "${OUTPUT}" ABSOLUTE BASE_DIR "${root}")
if(NOT DEFINED TOOLS)
    set(TOOLS "${root}/build/cpp-research")
endif()
get_filename_component(TOOLS "${TOOLS}" ABSOLUTE BASE_DIR "${root}")
set(bindir "${TOOLS}")
if(NOT EXISTS "${bindir}/deepprint_train.exe" AND EXISTS "${TOOLS}/Release/deepprint_train.exe")
    set(bindir "${TOOLS}/Release")
endif()
set(pairs "log/fvc2004-roi-deployment-20261125/app-run/logs/run-1795556427179-31364-1/pairs.csv")
set(model "build/evaluator/deepprint_texminu_512.onnx")
set(split "log/fvc-branch-tuning-20261126/split.csv")
if(STUDY STREQUAL "augmentation")
    set(split "log/fvc-augmentation-tuning-20261126/folds.csv")
endif()
function(run)
    execute_process(COMMAND ${ARGV} WORKING_DIRECTORY "${root}" COMMAND_ERROR_IS_FATAL ANY)
endfunction()
if(NOT VERIFY_ONLY)
    run("${bindir}/deepprint_train.exe" "${STUDY}" "${model}" data/fvc "${pairs}" "${split}" "${out}")
endif()
file(STRINGS "${out}/selection.csv" selection)
list(GET selection 1 selected)
string(REPLACE "," ";" values "${selected}")
list(GET values 8 weight)
# Inherit the already tested native compiler and generator of the research build.
load_cache("${TOOLS}" READ_WITH_PREFIX research_ CMAKE_GENERATOR CMAKE_CXX_COMPILER CMAKE_MAKE_PROGRAM CMAKE_GENERATOR_PLATFORM)
set(toolchain -G "${research_CMAKE_GENERATOR}" "-DCMAKE_CXX_COMPILER=${research_CMAKE_CXX_COMPILER}")
if(research_CMAKE_MAKE_PROGRAM)
    list(APPEND toolchain "-DCMAKE_MAKE_PROGRAM=${research_CMAKE_MAKE_PROGRAM}")
endif()
if(research_CMAKE_GENERATOR_PLATFORM)
    list(APPEND toolchain -A "${research_CMAKE_GENERATOR_PLATFORM}")
endif()
run("${CMAKE_COMMAND}" -S "${root}" -B "${out}/native" ${toolchain} -DCMAKE_BUILD_TYPE=Release
    -DFINGERPRINT_DEEPPRINT=ON -DFINGERPRINT_BUILD_GUI=OFF -DBUILD_TESTING=OFF
    "-DFINGERPRINT_TEXTURE_WEIGHT=${weight}" "-DFINGERPRINT_DEEPPRINT_MODEL=${out}/deepprint_texminu_512.onnx")
run("${CMAKE_COMMAND}" --build "${out}/native" --config Release --target IndustryAlgorithm --parallel 4)
set(dll "${out}/native/IndustryAlgorithm.dll")
if(NOT EXISTS "${dll}")
    set(dll "${out}/native/Release/IndustryAlgorithm.dll")
endif()
run("${bindir}/deepprint_research.exe" verify data/fvc "${pairs}" "${dll}" "${out}/deepprint_texminu_512.onnx" "${out}/native-parity.csv" "${weight}")

